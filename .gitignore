# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environment (never commit this — it's machine-specific and huge)
venv/
.venv/
env/

# Environment variables / secrets (API keys go here later, never in code)
.env
.env.*

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Data caches / downloaded market data (regenerable, keep repo lightweight)
data/raw/
data/cache/
*.csv
*.parquet

# Live-trading safety gate durable state (spec 032) -- machine-local runtime
# state (kill latch, halts, reservations), never regenerable and never
# committed, but also never read by another checkout.
data/live_safety/
*.db
*.db-wal
*.db-shm

# OS/editor cruft
.DS_Store
Thumbs.db

# Local wrapper-tool runtime state (PID, port, env-var lock). Machine-specific
# and stale the moment the process exits - never meaningful to another checkout.
.claude/.headroom_wrap_*

# Detached agent-run logs (machine-local, never meaningful to another checkout)
review_*.log
*.log
